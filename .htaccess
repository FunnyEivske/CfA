# Beskyttelse mot opplisting av mapper
Options -Indexes

DirectoryIndex pages/index.html index.html index.php

# Rewrite Engine for pene URL-er (uten .html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Unnta /artcraft/ og /.well-known/ direkte fra all omskriving og omdirigering
    RewriteRule ^artcraft(/.*)?$ - [L]
    RewriteRule ^\.well-known(/.*)?$ - [L]

    # Direkte servering av SEO, AI og standard metadata-filer i roten
    RewriteRule ^(robots\.txt|sitemap\.xml|ai\.txt|llms\.txt|ads\.txt|humans\.txt|security\.txt)$ - [L]

    # Aliaser for personvern og vilkår
    RewriteRule ^privacy/?$ pages/personvern.html [L]
    RewriteRule ^terms/?$ pages/vilkar.html [L]
    RewriteRule ^vilkar/?$ pages/vilkar.html [L]

    # Server pages/index.html ved rot-forespørsel (/)
    RewriteRule ^$ pages/index.html [L]

    # Omadresser forespørsler med /pages/ eller .html til ren URL i adressefeltet (f.eks. /pages/galleri.html -> /galleri)
    RewriteCond %{THE_REQUEST} !/artcraft/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/(?:pages/)?([^.]+)\.html [NC]
    RewriteRule ^ /%1 [R=301,L]

    RewriteCond %{THE_REQUEST} !/artcraft/ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/pages/([^\s]+) [NC]
    RewriteRule ^ /%1 [R=301,L]

    # Automatisk servering av WebP hvis nettleseren støtter det og .webp finnes i /uploads/
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/uploads/$1.webp -f
    RewriteRule ^uploads/(.+)\.(jpe?g|png)$ uploads/$1.webp [T=image/webp,E=accept:1,L]

    # Omadresser cfa admin merke til ren /merkeverktoy/ URL
    RewriteRule ^cfa(?:%20|\s|-)admin(?:%20|\s|-)merke(?:/(.*))?$ /merkeverktoy/$1 [R=301,L,NE]

    # Server creative-tools
    RewriteRule ^creative-tools/?$ pages/creative-tools.html [L]
    RewriteRule ^kreative-verktoy/?$ pages/creative-tools.html [L]

    # Server merkeverktoy .html-filer uten filendelse
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/merkeverktoy/$1.html -f
    RewriteRule ^merkeverktoy/(.*?)/?$ merkeverktoy/$1.html [L]

    # Server .html-filen internt fra pages/ hvis forespørselen matcher en fil i pages/
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/pages/$1.html -f
    RewriteRule ^(.*?)/?$ pages/$1.html [L]

    # Fallback: Server .html-filen internt hvis forespørselen matcher en fil i rotmappen
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# Blokker direkte tilgang til sensitive filer, inkludert config.php og schema.sql
<FilesMatch "^(config\.php|schema\.sql|package\.json|package-lock\.json|\.gitignore|\.gitattributes|task\.md|README\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|ini|env|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokker tilgang til skjulte filer og mapper som .git
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Komprimering (Gzip / Deflate for optimal hastighet og FCP)
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE image/x-icon
    AddOutputFilterByType DEFLATE font/ttf
    AddOutputFilterByType DEFLATE font/otf
    AddOutputFilterByType DEFLATE font/opentype
</IfModule>

# Caching av statiske ressurser (Leverage Browser Caching)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 hour"

    # Bilder og ikoner: 1 år
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # Fonter: 1 år
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # CSS og JS: 30 dager
    ExpiresByType text/css "access plus 30 days"
    ExpiresByType application/javascript "access plus 30 days"
    ExpiresByType text/javascript "access plus 30 days"

    # Dokumenter / HTML: Alltid ferskt
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Sikkerhets- og Cache-headere
<IfModule mod_headers.c>
    # Sikkerhets- og personvernheadere
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Content-Security-Policy "default-src 'self' https: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://fonts.googleapis.com blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://cosplayforalle.no https://www.google-analytics.com https://analytics.google.com https://region1.google-analytics.com; media-src 'self' data: blob: https:; object-src 'none'; base-uri 'self'; form-action 'self';"
    Header set Permissions-Policy "accelerometer=(), camera=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"

    # Aggressiv caching for statiske medier
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|otf)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # Caching for stilark og scripts
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=2592000, public"
    </FilesMatch>

    # Alltid ferske HTML-dokumenter
    <FilesMatch "\.(html|php)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
    </FilesMatch>

    # WebAssembly MIME-type og Cross-Origin Isolation for ArtCraft (/artcraft/**)
    <If "%{REQUEST_URI} =~ m#^/artcraft/#">
        Header set Cross-Origin-Opener-Policy "same-origin"
        Header set Cross-Origin-Embedder-Policy "require-corp"
    </If>
</IfModule>

# MIME-typer
AddType application/wasm .wasm

# Øk filopplastingsgrense dersom mod_php er aktiv
<IfModule mod_php7.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 128M
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 128M
</IfModule>

