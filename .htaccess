# Beskyttelse mot opplisting av mapper
Options -Indexes

# Rewrite Engine for pene URL-er (uten .html)
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Omadresser forespørsler med .html til ren URL i adressefeltet (f.eks. /galleri.html -> /galleri)
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
    RewriteRule ^ %1 [R=301,L]

    # Server .html-filen internt hvis forespørselen matcher en eksisterende HTML-fil
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{DOCUMENT_ROOT}/$1.html -f
    RewriteRule ^(.*?)/?$ $1.html [L]
</IfModule>

# Blokker direkte tilgang til sensitive filer, inkludert config.php og schema.sql
<FilesMatch "^(config\.php|schema\.sql|package\.json|package-lock\.json|\.gitignore|\.gitattributes|task\.md|README\.md)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "\.(sql|log|ini|env|sh|bak)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Blokker tilgang til skjulte filer og mapper som .git
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Sikkerhetsheadere
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
